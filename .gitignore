# MEAM 5170 final project: top-level ignores.
# Quadruped-PyMPC is a submodule with its own .gitignore (it already ignores acados' c_generated_code and *.json).

# acados source build. Only Mac users build it here (see SETUP.md); Linux and WSL get acados from pixi.
/acados/

# Environments
.pixi/
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# acados generated solvers: platform specific, regenerated on first run on each machine
c_generated_code*/

# Run outputs and datasets: keep them in data/ (ignored) or the shared Drive folder, not in git
/data/
*.npz
*.h5
*.pkl
MUJOCO_LOG.TXT

# Generated by trackC scripts: scene XMLs written with --out, default course.png from visualize_course.py
scene_*.xml
/trackC/course.png

# OS and editor files
.DS_Store
.vscode/
.idea/
*.swp

# Personal Claude Code instructions (each person keeps their own)
CLAUDE.local.md
